{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yofune:yasc:evidence-manifest:1.0",
  "title": "YASC Evidence Manifest",
  "type": "object",
  "required": ["evidence_manifest"],
  "properties": {
    "evidence_manifest": {
      "type": "object",
      "required": ["schema_version", "manifest_id", "generated_at", "case_id", "artifacts"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "manifest_id": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string"},
        "case_id": {"type": "string", "minLength": 1},
        "collector": {"type": "string"},
        "hash_algorithm": {"const": "sha256"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "path", "sha256", "size_bytes", "type"],
            "properties": {
              "artifact_id": {"type": "string"},
              "type": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "trace_id": {"type": "string"},
              "source_component": {"type": "string"},
              "collected_at": {"type": "string"},
              "sensitivity": {"enum": ["public", "internal", "confidential", "restricted", "unspecified"]},
              "redaction": {"type": "string"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
