{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YASC Verification Target",
  "type": "object",
  "required": [
    "target"
  ],
  "properties": {
    "target": {
      "type": "object",
      "required": [
        "schema_version",
        "name"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "prompt_config_hash": {
          "type": "string"
        },
        "deterministic": {
          "type": "boolean"
        },
        "tooling_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "mcp": {
          "$ref": "#/$defs/mcp"
        }
      },
      "anyOf": [
        {
          "required": [
            "agent"
          ]
        },
        {
          "required": [
            "mcp"
          ]
        }
      ]
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "mock-agent",
            "http-agent",
            "openai-responses",
            "anthropic-messages",
            "langgraph",
            "crewai"
          ]
        },
        "mode": {
          "enum": [
            "secure",
            "insecure"
          ]
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 0.1
        },
        "verify_tls": {
          "type": "boolean"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reset_url": {
          "type": "string"
        },
        "request": {
          "type": "object"
        },
        "response": {
          "type": "object"
        },
        "model": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "api_key": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "instructions": {},
        "system": {},
        "tools": {
          "type": "array"
        },
        "tool_choice": {},
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "anthropic_version": {
          "type": "string"
        },
        "conversation": {
          "type": "boolean"
        },
        "context_as_metadata": {
          "type": "boolean"
        },
        "graph": {
          "type": "string"
        },
        "crew": {
          "type": "string"
        },
        "factory": {
          "type": "boolean"
        },
        "input_mode": {
          "enum": [
            "messages",
            "string",
            "mapping"
          ]
        },
        "input_field": {
          "type": "string"
        },
        "messages_field": {
          "type": "string"
        },
        "context_field": {
          "type": "string"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "invoke_config": {
          "type": "object"
        },
        "inputs": {
          "type": "object"
        },
        "input_key": {
          "type": "string"
        },
        "context_key": {
          "type": "string"
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "mcp-stdio",
            "mcp-http"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 0.1
        },
        "verify_tls": {
          "type": "boolean"
        },
        "protocol_version": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "auto",
            "modern",
            "legacy",
            "2026-07-28"
          ]
        },
        "legacy_protocol_version": {
          "type": "string"
        },
        "probe_timeout_seconds": {
          "type": "number",
          "minimum": 0.05
        }
      }
    }
  }
}
