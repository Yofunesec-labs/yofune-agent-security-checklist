{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yofune:yasc:controls:0.1",
  "title": "Yofune Agent Security Checklist Controls",
  "type": "object",
  "required": [
    "metadata",
    "domains",
    "controls"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version",
        "snapshot_date",
        "assurance_levels"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "question",
          "principle"
        ]
      }
    },
    "controls": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "domain",
          "severity",
          "objective",
          "threat",
          "check",
          "adversarial_tests",
          "evidence",
          "pass_criteria",
          "mappings",
          "target_assurance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^YAS-[0-9]{2}\\.[0-9]{2}$"
          },
          "domain": {
            "type": "string",
            "pattern": "^YAS-[0-9]{2}$"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "target_assurance": {
            "enum": [
              "YAL-0",
              "YAL-1",
              "YAL-2",
              "YAL-3",
              "YAL-4"
            ]
          },
          "adversarial_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^YAT-[A-Z]+-[0-9]{3}$"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "mappings": {
            "type": "object",
            "required": [
              "owasp_agentic_2026",
              "nist_ai_rmf_functions"
            ]
          }
        }
      }
    }
  }
}
