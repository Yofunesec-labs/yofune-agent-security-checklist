{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yofune:yasc:tests:0.1",
  "title": "YASC Verification Tests",
  "type": "object",
  "required": [
    "metadata",
    "tests"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "version",
        "snapshot_date"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "purpose",
          "preconditions",
          "procedure",
          "expected_result",
          "evidence",
          "controls",
          "safety"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^YAT-[A-Z]+-[0-9]{3}$"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "preconditions": {
            "type": "array",
            "minItems": 1
          },
          "procedure": {
            "type": "array",
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
