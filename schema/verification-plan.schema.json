{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yofune:yasc:verification-plan:1.0",
  "title": "YASC Verification Plan",
  "type": "object",
  "required": ["verification_plan"],
  "properties": {
    "verification_plan": {
      "type": "object",
      "required": ["schema_version", "plan_id", "yasc_version", "system", "scope", "control_ids", "test_ids", "environment", "trial_policy", "evidence_policy", "safety"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "plan_id": {"type": "string", "minLength": 1},
        "yasc_version": {"type": "string", "minLength": 1},
        "created_at": {"type": "string"},
        "owner": {"type": "string"},
        "reviewer": {"type": "string"},
        "independence": {"enum": ["self-review", "independent-internal", "independent-external", "unspecified"]},
        "system": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string"},
            "application_version": {"type": "string"},
            "model": {"type": "string"},
            "agent_framework": {"type": "string"},
            "tenant": {"type": "string"}
          }
        },
        "scope": {
          "type": "object",
          "required": ["included", "excluded"],
          "properties": {
            "included": {"type": "array", "items": {"type": "string"}},
            "excluded": {"type": "array", "items": {"type": "string"}},
            "high_impact_actions": {"type": "array", "items": {"type": "string"}},
            "trust_boundaries": {"type": "array", "items": {"type": "string"}}
          }
        },
        "profiles": {"type": "array", "items": {"type": "string"}},
        "control_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^YAS-[0-9]{2}\\.[0-9]{2}$"}},
        "test_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^YAT-[A-Z]+-[0-9]{3}$"}},
        "environment": {"enum": ["unit", "integration", "staging", "production-safe"]},
        "oracles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "source"],
            "properties": {
              "name": {"type": "string"},
              "source": {"type": "string"},
              "failure_condition": {"type": "string"},
              "success_condition": {"type": "string"}
            }
          }
        },
        "trial_policy": {
          "type": "object",
          "required": ["default_trials", "state_reset"],
          "properties": {
            "default_trials": {"type": "integer", "minimum": 1},
            "critical_trials": {"type": "integer", "minimum": 1},
            "state_reset": {"enum": ["always", "between-variants", "never", "test-specific"]},
            "randomness_control": {"type": "string"},
            "variant_strategy": {"type": "string"}
          }
        },
        "evidence_policy": {
          "type": "object",
          "required": ["minimum_set", "hash_artifacts"],
          "properties": {
            "minimum_set": {"type": "array", "items": {"type": "string"}},
            "hash_artifacts": {"type": "boolean"},
            "time_sync_required": {"type": "boolean"},
            "retention": {"type": "string"},
            "sensitivity": {"type": "string"},
            "redaction_policy": {"type": "string"}
          }
        },
        "change_baseline": {"type": "object"},
        "safety": {
          "type": "object",
          "required": ["authorization", "data_policy", "containment"],
          "properties": {
            "authorization": {"type": "string"},
            "data_policy": {"type": "string"},
            "containment": {"type": "string"},
            "prohibited_targets": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
